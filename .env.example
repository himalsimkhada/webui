# Web UI Admin (webui) — docker-compose.yml configuration.
# Copy this file to `.env`, edit the values, then: docker compose up -d --build

# Comma-separated list of backend modules this admin UI proxies, as name=base_url.
# Each backend must expose /api, /metrics, /healthz and /readyz on that URL.
# Bare-metal: point at localhost ports. In a compose stack, use service names
# (e.g. nginx=http://nginx-webui:8400). To reach backends running on the Docker
# host itself, use host.docker.internal (enabled below via extra_hosts).
# The examples below assume:
#   - nginx-webui backend  → host port 8400
#   - bind9-webui backend  → host port 5000
PORTAL_MODULES=nginx=http://host.docker.internal:8400,bind=http://host.docker.internal:5000

# Shared admin password. EACH backend must be configured with the SAME value so
# this facade can log in to them automatically. Leave empty to disable auth.
WEBUI_PASSWORD=change-me

# Secret used to sign this facade's session cookie. Backends use their own.
SECRET_KEY=change-me-to-a-long-random-string

# Host port the admin UI is published on.
WEBUI_PORT=8080

# Seconds to wait for backend responses.
BACKEND_TIMEOUT=5